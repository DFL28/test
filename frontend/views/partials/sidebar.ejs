<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="user-info">
      <% if (currentUser) { %>
        <img src="<%= currentUser.avatar_path || '/img/default-avatar.svg' %>" alt="Avatar" class="avatar">
        <span class="username"><%= currentUser.username %></span>
        <a href="/profile" class="settings-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 1v6m0 6v6M5.6 5.6l4.2 4.2m4.2 4.2l4.2 4.2M1 12h6m6 0h6M5.6 18.4l4.2-4.2m4.2-4.2l4.2-4.2"></path>
          </svg>
        </a>
      <% } else { %>
        <img src="/img/default-avatar.svg" alt="Guest" class="avatar">
        <span class="username">Guest</span>
      <% } %>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="nav-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      </svg>
      Home
    </a>
    <a href="/genre" class="nav-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      Genre
    </a>

    <div class="nav-divider"></div>

    <% if (!currentUser) { %>
      <a href="/login" class="nav-link">Login</a>
      <a href="/signup" class="nav-link">Register</a>
    <% } else { %>
      <% if (currentUser.is_admin) { %>
        <a href="/admin" class="nav-link">Admin Dashboard</a>
      <% } %>
      <a href="/logout" class="nav-link">Logout</a>
    <% } %>
  </nav>
</div>
